rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'trivabsports@gmail.com' ||
        request.auth.token.email == 'trivabsportsandevents@gmail.com' ||
        request.auth.token.email == 'jayvarma211@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }
    
    // User collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    
    // Players collection (publicly readable for match day, stats & QR verification)
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Registrations collection (publicly readable for roster compile & verification)
    match /registrations/{regId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Captains collection
    match /captains/{captainId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Teams collection
    match /teams/{teamId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Tournaments collection
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Matches collection (read & update match day scores/rosters)
    match /matches/{matchId} {
      allow read: if true;
      allow write: if true;
    }

    // Schedules collection
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Sponsors collection
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Notifications collection
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }
    
    // QR Scan logs
    match /qr_scan_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Gallery collection
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Player stats collection
    match /player_stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Team stats collection
    match /team_stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin logs collection
    match /admin_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // News events collection
    match /news_events/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin notifications collection
    match /admin_notifications/{notifId} {
      allow read: if true;
      allow write: if true;
    }

    // Contact inquiries collection
    match /contact_inquiries/{inquiryId} {
      allow read: if true;
      allow write: if true;
    }

    // Team fees collection
    match /team_fees/{feeId} {
      allow read: if true;
      allow write: if true;
    }

    // Payment history collection
    match /payment_history/{historyId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
